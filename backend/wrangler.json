{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "dinner-engine-ai",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-21",
  "workers_dev": true,
  "preview_urls": false,
  "durable_objects": {
    "bindings": [
      {
        "name": "USAGE_LEDGER",
        "class_name": "UsageLedger"
      }
    ]
  },
  "exports": {
    "UsageLedger": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  }
}
